{
  "name": "discapture",
  "version": "0.1.0",
  "description": "Discord chat capture and archival tool",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "bun run scripts/install-electrobun-cli.ts",
    "build": "electrobun build && bun run scripts/postbuild.ts",
    "dev": "electrobun dev",
    "start": "electrobun dev",
    "test": "bun test",
    "snapshot": "bun run tests/generate-snapshot.ts"
  },
  "dependencies": {
    "electrobun": "^1.16.0",
    "puppeteer-core": "^24.37.3"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
